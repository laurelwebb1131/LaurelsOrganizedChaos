# Server-only provider configuration. Never expose API keys through VITE_* variables.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional comma-separated browser origins allowed to call the standalone companion server.
# Example: https://example.com,http://localhost:5173
HEARTHWISE_ALLOWED_ORIGINS=

# Optional public companion API endpoint for packaged desktop builds.
# This must be an HTTPS endpoint you control. Do not put secrets in this value.
# Browser development falls back to /api/companion when this is blank.
VITE_COMPANION_API_URL=
